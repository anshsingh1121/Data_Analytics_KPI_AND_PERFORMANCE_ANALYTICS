# Environment & Secrets (NEVER COMMIT)
.env
.env.local
.env.*.local
*.env
*.pem
*.crt
*.cer
data/*.pem

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
.venv/
venv/
env/
ENV/

# Local Data, Snapshots, Runs & Generated Artifacts
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/snapshots/*
!data/snapshots/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep
data/runs/*
!data/runs/.gitkeep

# Build and Distribution Artifacts
dist/
build/
dist_corporate/
*.spec.bak

# Generated Reports & Logs
reports/*
!reports/.gitkeep
logs/*
!logs/.gitkeep

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
