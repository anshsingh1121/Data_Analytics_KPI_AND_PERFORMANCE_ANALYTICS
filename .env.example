# ==============================================================================
# DATA CERTIFICATION KPI & PERFORMANCE ANALYTICS — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. On your corporate machine, copy this file to '.env' (in the project root).
# 2. Fill in your API_BASE_URL, API_USERNAME, and API_PASSWORD.
# 3. Set APP_MODE=live.
# 4. NEVER commit or push your real '.env' file to Git!

# ------------------------------------------------------------------------------
# 1. Target ServiceNow Instance
# Note: Provide ONLY the base domain (e.g. https://company.service-now.com).
# Do NOT include browser navigation paths like /navpage.do or /now/nav/ui/home.
# ------------------------------------------------------------------------------
API_BASE_URL=https://your-instance.service-now.com
API_PROVIDER=servicenow
API_AUTH_METHOD=basic

# Basic Authentication Credentials
API_USERNAME=your_username_here
API_PASSWORD=your_password_here

# ------------------------------------------------------------------------------
# 2. SSL / TLS Security & Corporate Firewall Settings
# ------------------------------------------------------------------------------
# API_VERIFY_TLS (Default: true)
# When set to 'true', the application automatically reads and trusts your Windows
# OS Corporate Root Certificates (Zscaler, Netskope, Blue Coat, internal PKI)
# while maintaining full cryptographic TLS verification.
API_VERIFY_TLS=true

# Optional: If your IT department provided a specific corporate root certificate file (.pem or .cer):
# API_CA_BUNDLE=C:\path\to\corporate_root_ca.pem

# Optional: If you work behind an explicit corporate HTTP proxy:
# HTTP_PROXY=http://proxy.corporate.example:8080
# HTTPS_PROXY=http://proxy.corporate.example:8080

# ------------------------------------------------------------------------------
# 3. Connection & Performance Tuning
# ------------------------------------------------------------------------------
API_TIMEOUT_SECONDS=30
API_PAGE_SIZE=500
API_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 4. Application Mode (demo or live)
# ------------------------------------------------------------------------------
APP_MODE=live
